{
  "name": "hms",
  "version": "0.0.0",
  "private": true,
  "description": "Hospital Management System — multi-tenant SaaS",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build --workspace=@hms/shared && concurrently -n shared,api,web -c gray,blue,green \"npm:dev:shared\" \"npm:dev:api\" \"npm:dev:web\"",
    "dev:shared": "npm run dev --workspace=@hms/shared",
    "dev:api": "npm run start:dev --workspace=api",
    "dev:web": "npm run dev --workspace=web",
    "build": "npm run build --workspace=@hms/shared && npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "db:migrate": "npm run prisma:migrate --workspace=api",
    "db:generate": "npm run prisma:generate --workspace=api",
    "db:seed": "npm run prisma:seed --workspace=api",
    "db:studio": "npm run prisma:studio --workspace=api",
    "db:reset": "npm run prisma:reset --workspace=api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
