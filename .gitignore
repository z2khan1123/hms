# dependencies
node_modules/
.pnp
.pnp.js

# builds
dist/
build/
out/
*.tsbuildinfo
.tmp/

# env / secrets
.env
.env.local
.env.*.local
# Anything derived from a .env holds the same credentials — a hand-made backup
# before an edit is the easy way to commit a database password by accident.
.env.bak
.env.*.bak
.env.backup
.env.save
*.pem
*.key

# test / coverage
coverage/
.nyc_output/

# logs
*.log
npm-debug.log*
logs/

# editors / os
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json

# caches
.turbo/
.vite/
.cache/

# prisma
apps/api/prisma/*.db

# Temporary git worktrees used by background agents. They are working copies of
# this same repo — committing one would nest the repository inside itself.
.claude/worktrees/
