# ---------------------------------------------------------------------------
# Root env — copy to .env for docker compose (local infra).
# App-specific env lives in apps/api/.env and apps/web/.env
# ---------------------------------------------------------------------------

# Postgres (docker compose)
POSTGRES_USER=hms
POSTGRES_PASSWORD=hms_dev_password
POSTGRES_DB=hms
POSTGRES_PORT=5432

# Redis (docker compose)
REDIS_PORT=6379

# Adminer (DB web UI)
ADMINER_PORT=8080

# Mailhog (catches outbound email in dev)
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
