// HMS data model. Entity/field names track HL7 FHIR R4 where an analogue exists.
//
// Multi-tenancy: every tenant-scoped row carries `tenantId`. Postgres Row-Level
// Security is added in a separate raw-SQL migration (Prisma does not model RLS) —
// see docs/architecture.md#multi-tenancy.
//
// Money: integer MINOR units (paisa for PKR) in `*Minor` fields — never floats.
// Percentages: integer BASIS POINTS in `*Bps` fields (1800 = 18.00%).
// See docs/data-model.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  platform_admin
  hospital_admin
  doctor
  nurse
  receptionist
  accountant
  pharmacist
  pathologist
  radiologist
  read_only
}

enum Gender {
  male
  female
  other
  unknown
}

enum MaritalStatus {
  single
  married
  widowed
  separated
  not_specified
}

enum PatientStatus {
  active
  inactive
  deceased
}

enum AppointmentStatus {
  booked
  arrived
  fulfilled
  cancelled
  noshow
}

/// A Case is the spine of the clinical record: visits, charges and payments all
/// hang off it, which is what makes one consolidated bill per episode possible.
enum CaseStatus {
  open
  closed
  moved_to_ipd
}

enum OpdVisitStatus {
  /// Created at the desk; the consultation fee is not settled yet.
  registered
  /// Fee settled — the patient is in the doctor's queue.
  waiting
  in_consultation
  completed
  cancelled
}

enum PaymentMode {
  cash
  cheque
  bank_transfer
  card
  online
  other
}

/// Optional grouping on a service, for filtering and revenue reporting.
/// Extended as later modules land.
enum ServiceDepartment {
  opd
  procedure
  laboratory
  radiology
  pharmacy
  inpatient
  ambulance
  other
}

/// Money state of one bill line. Independent of whether the work was done.
enum BillItemStatus {
  pending
  paid
  cancelled
  refunded
}

/// Work state of a doctor's order. Whether it may START is decided by the
/// linked bill item (paid, or approved without payment) — never duplicated here.
enum ServiceOrderStatus {
  ordered
  /// Specimen taken. Meaningless for imaging, which goes straight to in_progress.
  sample_collected
  in_progress
  completed
  cancelled
}

/// A bed being BLOCKED is a stored decision (cleaning, maintenance, reserved).
/// A bed being OCCUPIED is not stored — it is derived from an open bed
/// assignment, so the board can never disagree with who is actually in it.
enum BedBlockReason {
  cleaning
  maintenance
  reserved
  other
}

enum AdmissionStatus {
  admitted
  discharged
  cancelled
}

/// How serious a recorded allergy is. Drives how loudly the prescriber is warned.
enum AllergySeverity {
  mild
  moderate
  severe
}

/// Which way stock moved. Quantity on hand is DERIVED by summing these — there
/// is no stored balance to fall out of step with the movements that made it.
enum StockMoveKind {
  receipt
  issue
  adjustment
}

enum AttendanceStatus {
  present
  absent
  late
  half_day
  on_leave
  holiday
}

enum LeaveRequestStatus {
  pending
  approved
  rejected
  cancelled
}

/// A payroll run is locked once paid. Payslips are documents people keep.
enum PayrollRunStatus {
  draft
  finalised
  paid
}

enum PayslipLineKind {
  earning
  deduction
}

enum BloodGroup {
  A_POS  @map("A+")
  A_NEG  @map("A-")
  B_POS  @map("B+")
  B_NEG  @map("B-")
  AB_POS @map("AB+")
  AB_NEG @map("AB-")
  O_POS  @map("O+")
  O_NEG  @map("O-")
}

enum BloodComponent {
  whole_blood
  packed_red_cells
  plasma
  platelets
  cryoprecipitate
}

enum VehicleType {
  basic
  advanced_life_support
  patient_transport
  mortuary
}

enum EmergencyLevel {
  critical
  urgent
  routine
}

enum DeliveryType {
  normal
  caesarean
  assisted
  other
}

enum CallDirection {
  incoming
  outgoing
}

enum PostalDirection {
  received
  dispatched
}

enum ComplaintStatus {
  open
  in_progress
  resolved
  closed
}

enum ComplaintSeverity {
  low
  medium
  high
}

enum DeliveryStatus {
  pending
  delivered
  failed
  abandoned
}

enum AppointmentRequestStatus {
  pending
  booked
  declined
}

enum VitalFlag {
  low
  normal
  high
}

enum AuditOutcome {
  success
  failure
}

// ---------------------------------------------------------------------------
// Tenancy & identity
// ---------------------------------------------------------------------------

model Tenant {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  slug     String  @unique
  isActive Boolean @default(true)

  /// ISO 4217. Drives minor-unit scaling in the UI.
  currency String @default("PKR")
  timezone String @default("Asia/Karachi")

  // Human-facing document numbers. Prefix + zero-padded per-tenant counter.
  mrnPrefix       String @default("MRN")
  mrnSeq          Int    @default(0)
  casePrefix      String @default("CASE")
  caseSeq         Int    @default(0)
  opdPrefix       String @default("OPD")
  opdSeq          Int    @default(0)
  receiptPrefix   String @default("RCPT")
  receiptSeq      Int    @default(0)
  admissionPrefix String @default("IPD")
  admissionSeq    Int    @default(0)
  staffPrefix     String @default("EMP")
  staffSeq        Int    @default(0)
  donorPrefix     String @default("DNR")
  donorSeq        Int    @default(0)
  callPrefix      String @default("AMB")
  callSeq         Int    @default(0)
  birthPrefix     String @default("BIR")
  birthSeq        Int    @default(0)
  deathPrefix     String @default("DTH")
  deathSeq        Int    @default(0)
  visitorPrefix   String @default("VIS")
  visitorSeq      Int    @default(0)
  complaintPrefix String @default("CMP")
  complaintSeq    Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 User[]
  patients              Patient[]
  practitioners         Practitioner[]
  appointments          Appointment[]
  tpas                  Tpa[]
  cases                 Case[]
  opdVisits             OpdVisit[]
  services              Service[]
  billItems             BillItem[]
  payments              Payment[]
  symptomTypes          SymptomType[]
  symptoms              Symptom[]
  findings              Finding[]
  vitalTypes            VitalType[]
  vitalReadings         VitalReading[]
  serviceOrders         ServiceOrder[]
  prescriptionItems     PrescriptionItem[]
  floors                Floor[]
  wards                 Ward[]
  bedTypes              BedType[]
  beds                  Bed[]
  admissions            Admission[]
  bedAssignments        BedAssignment[]
  nurseNotes            NurseNote[]
  labTests              LabTest[]
  labTestParameters     LabTestParameter[]
  diagnosticReports     DiagnosticReport[]
  diagnosticValues      DiagnosticValue[]
  medicineCategories    MedicineCategory[]
  medicines             Medicine[]
  medicineBatches       MedicineBatch[]
  medicinePurchases     MedicinePurchase[]
  medicinePurchaseItems MedicinePurchaseItem[]
  dispenses             Dispense[]
  dispenseItems         DispenseItem[]
  patientAllergies      PatientAllergy[]
  incomeHeads           IncomeHead[]
  incomes               Income[]
  expenseHeads          ExpenseHead[]
  expenses              Expense[]
  referrers             Referrer[]
  referralPayments      ReferralPayment[]
  itemCategories        ItemCategory[]
  stores                Store[]
  inventoryItems        InventoryItem[]
  stockMoves            StockMove[]
  departments           Department[]
  designations          Designation[]
  staffProfiles         StaffProfile[]
  staffAttendances      StaffAttendance[]
  leaveTypes            LeaveType[]
  leaveRequests         LeaveRequest[]
  shifts                Shift[]
  rosterEntries         RosterEntry[]
  payrollRuns           PayrollRun[]
  payslips              Payslip[]
  payslipLines          PayslipLine[]
  savedViews            SavedView[]
  donors                Donor[]
  bloodUnits            BloodUnit[]
  bloodIssues           BloodIssue[]
  vehicles              Vehicle[]
  ambulanceCalls        AmbulanceCall[]
  birthRecords          BirthRecord[]
  deathRecords          DeathRecord[]
  visitorLogs           VisitorLog[]
  phoneCallLogs         PhoneCallLog[]
  postalLogs            PostalLog[]
  complaints            Complaint[]
  apiKeys               ApiKey[]
  webhookEndpoints      WebhookEndpoint[]
  webhookDeliveries     WebhookDelivery[]
  patientAccounts       PatientAccount[]
  appointmentRequests   AppointmentRequest[]
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String?   @db.Uuid
  tenant       Tenant?   @relation(fields: [tenantId], references: [id])
  email        String
  passwordHash String
  firstName    String
  lastName     String
  role         Role      @default(read_only)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshTokens      RefreshToken[]
  practitioner       Practitioner?
  staffProfile       StaffProfile?
  savedViews         SavedView[]
  assignedComplaints Complaint[]    @relation("ComplaintAssignee")

  @@unique([tenantId, email])
  @@index([email])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Patient & payer
// ---------------------------------------------------------------------------

/// Third Party Administrator — the insurer/panel that settles a patient's bill.
model Tpa {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @db.Uuid
  tenant             Tenant   @relation(fields: [tenantId], references: [id])
  name               String
  code               String?
  phone              String?
  address            String?
  contactPersonName  String?
  contactPersonPhone String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  patients Patient[]
  cases    Case[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Patient {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  mrn      String

  firstName     String
  lastName      String
  guardianName  String?
  gender        Gender
  birthDate     DateTime       @db.Date
  maritalStatus MaritalStatus?
  bloodType     String?

  phone          String
  alternatePhone String?
  email          String?
  address        Json?

  // CNIC is never stored in plaintext — salted hash for matching, last 4 for display.
  nationalIdHash  String?
  nationalIdLast4 String?

  photoUrl       String?
  knownAllergies String?
  remarks        String?

  tpaId        String?   @db.Uuid
  tpa          Tpa?      @relation(fields: [tpaId], references: [id])
  tpaMemberId  String?
  tpaValidTill DateTime? @db.Date

  status    PatientStatus @default(active)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  appointments      Appointment[]
  cases             Case[]
  opdVisits         OpdVisit[]
  vitalReadings     VitalReading[]
  serviceOrders     ServiceOrder[]
  admissions        Admission[]
  diagnosticReports DiagnosticReport[]
  dispenses         Dispense[]
  allergies         PatientAllergy[]
  bloodIssues       BloodIssue[]
  ambulanceCalls    AmbulanceCall[]
  portalAccount      PatientAccount?
  appointmentRequests AppointmentRequest[]
  birthsAsMother    BirthRecord[]  @relation("BirthMother")
  birthsAsChild     BirthRecord[]  @relation("BirthChild")
  deathRecord       DeathRecord?
  visitorLogs       VisitorLog[]
  phoneCallLogs     PhoneCallLog[]
  complaints        Complaint[]

  @@unique([tenantId, mrn])
  @@index([tenantId, lastName, firstName])
  @@index([tenantId, phone])
  @@index([tenantId, nationalIdHash])
}

model Practitioner {
  id                   String  @id @default(uuid()) @db.Uuid
  tenantId             String  @db.Uuid
  tenant               Tenant  @relation(fields: [tenantId], references: [id])
  userId               String? @unique @db.Uuid
  user                 User?   @relation(fields: [userId], references: [id])
  firstName            String
  lastName             String
  specialty            String?
  department           String?
  /// The doctor's consultation fee. Pre-fills the charge at registration and is
  /// always editable — a doctor may concede a fee for a particular patient.
  consultationFeeMinor Int?
  isActive             Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments  Appointment[]
  appointmentRequests AppointmentRequest[]
  opdVisits     OpdVisit[]
  admissions    Admission[]
  birthsAttended BirthRecord[]
  deathsCertified DeathRecord[]

  @@index([tenantId, lastName, firstName])
}

model Appointment {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @db.Uuid
  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  patientId      String            @db.Uuid
  patient        Patient           @relation(fields: [patientId], references: [id])
  practitionerId String            @db.Uuid
  practitioner   Practitioner      @relation(fields: [practitionerId], references: [id])
  startsAt       DateTime
  endsAt         DateTime
  status         AppointmentStatus @default(booked)
  reason         String?
  notes          String?
  createdById    String?           @db.Uuid
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  opdVisit OpdVisit?

  portalRequest AppointmentRequest?

  @@index([tenantId, practitionerId, startsAt])
  @@index([tenantId, patientId, startsAt])
}

// ---------------------------------------------------------------------------
// Case — the episode of care that visits, charges and payments hang off
// ---------------------------------------------------------------------------

model Case {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @db.Uuid
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  patientId String  @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id])

  caseNo       String
  status       CaseStatus @default(open)
  openedAt     DateTime   @default(now())
  closedAt     DateTime?
  /// Why the episode was closed — `closeCaseSchema` accepts it and the audit
  /// trail deliberately stores no request bodies, so it is kept on the row.
  closedReason String?

  isCasualty Boolean   @default(false)
  reference  String?
  /// Who sent the patient, when a commission is owed for it.
  referrerId String?   @db.Uuid
  referrer   Referrer? @relation(fields: [referrerId], references: [id])

  // Payer snapshot at the time the case was opened — TPA terms can change later.
  tpaId        String?   @db.Uuid
  tpa          Tpa?      @relation(fields: [tpaId], references: [id])
  tpaMemberId  String?
  tpaValidTill DateTime? @db.Date

  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  opdVisits         OpdVisit[]
  billItems         BillItem[]
  payments          Payment[]
  vitalReadings     VitalReading[]
  serviceOrders     ServiceOrder[]
  admissions        Admission[]
  diagnosticReports DiagnosticReport[]
  dispenses         Dispense[]
  bloodIssues       BloodIssue[]
  ambulanceCalls    AmbulanceCall[]

  @@unique([tenantId, caseNo])
  @@index([tenantId, patientId, openedAt])
  @@index([tenantId, status])
}

// ---------------------------------------------------------------------------
// Services — what a patient can be charged for
// ---------------------------------------------------------------------------

/// A named thing the hospital does: a consultation, a dressing, an ECG.
/// It carries only an OPTIONAL suggested price. The price that actually gets
/// billed is entered on the patient's own record at the time of service, so a
/// clinic can charge one patient differently from the next without maintaining
/// a price book. The list exists so the NAME is consistent — otherwise "ECG",
/// "E.C.G." and "ecg" become three different things and revenue by service
/// can never be reported.
model Service {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name              String
  /// Optional tag, only for filtering long lists and grouping revenue reports.
  department        ServiceDepartment?
  /// Optional. Pre-fills the price field; always editable per patient.
  defaultPriceMinor Int?
  description       String?
  isActive          Boolean            @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  billItems     BillItem[]
  serviceOrders ServiceOrder[]
  labTest       LabTest?

  @@unique([tenantId, name])
  @@index([tenantId, department])
}

// Clinical vocabulary (tenant-editable) and ICD-10 (global reference data)
// ---------------------------------------------------------------------------

model SymptomType {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  symptoms Symptom[]

  @@unique([tenantId, name])
}

model Symptom {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @db.Uuid
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  symptomTypeId String      @db.Uuid
  symptomType   SymptomType @relation(fields: [symptomTypeId], references: [id])
  title         String
  description   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  visitSymptoms VisitSymptom[]

  @@unique([tenantId, symptomTypeId, title])
  @@index([tenantId])
}

model Finding {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  category    String?
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  visitFindings VisitFinding[]

  @@unique([tenantId, title])
  @@index([tenantId, category])
}

/// Global reference data — not tenant-scoped, no RLS.
model Icd10Group {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())

  codes Icd10Code[]
}

model Icd10Code {
  id      String     @id @default(uuid()) @db.Uuid
  groupId String     @db.Uuid
  group   Icd10Group @relation(fields: [groupId], references: [id])
  code    String     @unique
  title   String

  diagnoses VisitDiagnosis[]

  @@index([groupId])
  @@index([title])
}

// ---------------------------------------------------------------------------
// OPD visit
// ---------------------------------------------------------------------------

model OpdVisit {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  caseId    String  @db.Uuid
  case      Case    @relation(fields: [caseId], references: [id])
  patientId String  @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id])

  practitionerId String       @db.Uuid
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id])

  appointmentId String?      @unique @db.Uuid
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  opdNo   String
  visitAt DateTime

  isFollowUp    Boolean @default(false)
  isAntenatal   Boolean @default(false)
  isLiveConsult Boolean @default(false)
  reference     String?

  note                 String?
  previousMedicalIssue String?
  /// Allergies as stated at this visit; the patient master holds the running record.
  knownAllergies       String?

  status       OpdVisitStatus @default(waiting)
  /// Why the visit was cancelled — `setOpdVisitStatusSchema` accepts a reason and
  /// a cancelled visit that cannot say why is not defensible at a front desk.
  cancelReason String?

  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  symptoms          VisitSymptom[]
  findings          VisitFinding[]
  diagnoses         VisitDiagnosis[]
  vitalReadings     VitalReading[]
  billItems         BillItem[]
  serviceOrders     ServiceOrder[]
  prescriptionItems PrescriptionItem[]
  admission         Admission?
  dispenses         Dispense[]

  @@unique([tenantId, opdNo])
  @@index([tenantId, visitAt])
  @@index([tenantId, practitionerId, visitAt])
  @@index([tenantId, caseId])
  @@index([tenantId, status])
}

model VisitSymptom {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  opdVisitId String   @db.Uuid
  opdVisit   OpdVisit @relation(fields: [opdVisitId], references: [id], onDelete: Cascade)
  symptomId  String?  @db.Uuid
  symptom    Symptom? @relation(fields: [symptomId], references: [id])
  /// Free text when the symptom isn't in the tenant's vocabulary.
  title      String
  detail     String?
  createdAt  DateTime @default(now())

  @@index([tenantId, opdVisitId])
}

model VisitFinding {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  opdVisitId String   @db.Uuid
  opdVisit   OpdVisit @relation(fields: [opdVisitId], references: [id], onDelete: Cascade)
  findingId  String?  @db.Uuid
  finding    Finding? @relation(fields: [findingId], references: [id])
  title      String
  detail     String?
  createdAt  DateTime @default(now())

  @@index([tenantId, opdVisitId])
}

model VisitDiagnosis {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  opdVisitId  String    @db.Uuid
  opdVisit    OpdVisit  @relation(fields: [opdVisitId], references: [id], onDelete: Cascade)
  icd10CodeId String    @db.Uuid
  icd10Code   Icd10Code @relation(fields: [icd10CodeId], references: [id])
  isPrimary   Boolean   @default(false)
  note        String?
  createdAt   DateTime  @default(now())

  @@unique([opdVisitId, icd10CodeId])
  @@index([tenantId, opdVisitId])
}

// ---------------------------------------------------------------------------
// Doctor's orders and prescriptions
// ---------------------------------------------------------------------------

/// A service the doctor recommended — a lab test, an X-ray, a procedure.
/// It carries the CLINICAL life of the request. Whether it may start is decided
/// by its bill item (paid, or approved without payment), never duplicated here,
/// so the money and the work can never disagree.
model ServiceOrder {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  caseId     String    @db.Uuid
  case       Case      @relation(fields: [caseId], references: [id])
  patientId  String    @db.Uuid
  patient    Patient   @relation(fields: [patientId], references: [id])
  opdVisitId String?   @db.Uuid
  opdVisit   OpdVisit? @relation(fields: [opdVisitId], references: [id])

  serviceId   String?            @db.Uuid
  service     Service?           @relation(fields: [serviceId], references: [id])
  serviceName String
  department  ServiceDepartment?

  /// The money side. One order, one line on the bill.
  billItemId String?   @unique @db.Uuid
  billItem   BillItem? @relation(fields: [billItemId], references: [id])

  status        ServiceOrderStatus @default(ordered)
  note          String?
  orderedById   String?            @db.Uuid
  orderedAt     DateTime           @default(now())
  startedAt     DateTime?
  startedById   String?            @db.Uuid
  completedAt   DateTime?
  completedById String?            @db.Uuid
  cancelledAt   DateTime?
  cancelReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  report DiagnosticReport?

  @@index([tenantId, status])
  @@index([tenantId, department, status])
  @@index([tenantId, patientId, orderedAt])
  @@index([tenantId, opdVisitId])
}

/// One line of a prescription. The "prescription" is every line on a visit.
/// Free text until the medicine master arrives with the pharmacy module.
model PrescriptionItem {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  opdVisitId String   @db.Uuid
  opdVisit   OpdVisit @relation(fields: [opdVisitId], references: [id], onDelete: Cascade)

  /// Optional link to the medicine master. Free text still works — this is
  /// what lets prescribing check against the patient's recorded allergies.
  medicineId String?   @db.Uuid
  medicine   Medicine? @relation(fields: [medicineId], references: [id])

  drugName     String
  dose         String?
  frequency    String?
  durationDays Int?
  instructions String?
  sortOrder    Int     @default(0)

  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  @@index([tenantId, opdVisitId])
}

// ---------------------------------------------------------------------------
// Wards and beds — every hospital enters its own, so seven beds and seventy
// run identical code. Nothing here is a product tier.
// ---------------------------------------------------------------------------

model Floor {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wards Ward[]

  @@unique([tenantId, name])
}

/// e.g. Standard, Private, VIP, ICU. Carries a SUGGESTED nightly rate; what the
/// patient is actually charged is entered on their bill at discharge.
model BedType {
  id                      String   @id @default(uuid()) @db.Uuid
  tenantId                String   @db.Uuid
  tenant                  Tenant   @relation(fields: [tenantId], references: [id])
  name                    String
  defaultNightlyRateMinor Int?
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  beds Bed[]

  @@unique([tenantId, name])
}

model Ward {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  floorId   String   @db.Uuid
  floor     Floor    @relation(fields: [floorId], references: [id])
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  beds          Bed[]
  rosterEntries RosterEntry[]

  @@unique([tenantId, name])
  @@index([tenantId, floorId])
}

model Bed {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @db.Uuid
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  wardId    String  @db.Uuid
  ward      Ward    @relation(fields: [wardId], references: [id])
  bedTypeId String  @db.Uuid
  bedType   BedType @relation(fields: [bedTypeId], references: [id])

  /// Bed number as the ward writes it, e.g. GF-101.
  name String

  /// Taken out of service deliberately. Occupancy is NEVER stored here.
  isBlocked   Boolean         @default(false)
  blockReason BedBlockReason?
  blockNote   String?
  isActive    Boolean         @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments BedAssignment[]

  @@unique([tenantId, name])
  @@index([tenantId, wardId])
}

// ---------------------------------------------------------------------------
// Admission — the inpatient episode, hanging off the same Case spine as OPD
// ---------------------------------------------------------------------------

model Admission {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @db.Uuid
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  caseId    String  @db.Uuid
  case      Case    @relation(fields: [caseId], references: [id])
  patientId String  @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id])

  admissionNo String

  /// Set when the patient was moved in from an outpatient visit.
  fromOpdVisitId String?   @unique @db.Uuid
  fromOpdVisit   OpdVisit? @relation(fields: [fromOpdVisitId], references: [id])

  practitionerId String       @db.Uuid
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id])

  status       AdmissionStatus @default(admitted)
  admittedAt   DateTime        @default(now())
  dischargedAt DateTime?

  provisionalDiagnosis String?
  admissionNote        String?

  /// Filled at discharge.
  dischargeSummary String?
  dischargeAdvice  String?
  dischargedById   String?   @db.Uuid
  /// Discharge can be reverted; the reason is kept rather than the row erased.
  revertedAt       DateTime?
  revertReason     String?

  admittedById String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bedAssignments BedAssignment[]
  nurseNotes     NurseNote[]
  vitalReadings  VitalReading[]
  dispenses      Dispense[]

  @@unique([tenantId, admissionNo])
  @@index([tenantId, status])
  @@index([tenantId, patientId, admittedAt])
  @@index([tenantId, caseId])
}

/// Which bed, from when to when. An assignment with toAt = null IS the
/// occupancy — there is no separate flag to fall out of step with it.
model BedAssignment {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  admissionId String    @db.Uuid
  admission   Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  bedId       String    @db.Uuid
  bed         Bed       @relation(fields: [bedId], references: [id])

  fromAt     DateTime  @default(now())
  toAt       DateTime?
  moveReason String?

  assignedById String?  @db.Uuid
  createdAt    DateTime @default(now())

  @@index([tenantId, admissionId])
  @@index([tenantId, bedId, toAt])
}

model NurseNote {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  admissionId String    @db.Uuid
  admission   Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  note         String
  recordedAt   DateTime @default(now())
  recordedById String?  @db.Uuid
  createdAt    DateTime @default(now())

  @@index([tenantId, admissionId, recordedAt])
}

// ---------------------------------------------------------------------------
// Diagnostics — the test catalogue and its reports
//
// FHIR: LabTest maps to ObservationDefinition, DiagnosticReport and
// DiagnosticValue to DiagnosticReport and Observation.
//
// A report has NO status of its own. The ServiceOrder it belongs to carries the
// single work state; whether a result exists and whether `reportedAt` is set
// says the rest. Two statuses on one piece of work is how a worklist starts
// disagreeing with itself.
// ---------------------------------------------------------------------------

/// What a billable service actually measures. Pathology tests carry parameters;
/// imaging usually carries none and is reported as narrative findings.
model LabTest {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  /// The billable service this defines. One service, at most one definition.
  serviceId String?  @unique @db.Uuid
  service   Service? @relation(fields: [serviceId], references: [id])

  name       String
  department ServiceDepartment
  /// Blood, Urine, Sputum … null for imaging.
  sampleType String?
  method     String?
  isActive   Boolean           @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parameters LabTestParameter[]
  reports    DiagnosticReport[]

  @@unique([tenantId, name])
  @@index([tenantId, department])
}

model LabTestParameter {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @db.Uuid
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  labTestId String  @db.Uuid
  labTest   LabTest @relation(fields: [labTestId], references: [id], onDelete: Cascade)

  name      String
  unit      String?
  /// Numeric range for flagging. Null on both means "do not flag".
  refLow    Float?
  refHigh   Float?
  /// Where a range is not numeric, e.g. "Negative" or "Straw coloured".
  refText   String?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  values DiagnosticValue[]

  @@unique([labTestId, name])
  @@index([tenantId, labTestId])
}

model DiagnosticReport {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  /// One report per order. The order holds the status.
  serviceOrderId String       @unique @db.Uuid
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  patientId String  @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id])
  caseId    String  @db.Uuid
  case      Case    @relation(fields: [caseId], references: [id])

  labTestId String?  @db.Uuid
  labTest   LabTest? @relation(fields: [labTestId], references: [id])

  department ServiceDepartment

  sampleCollectedAt   DateTime?
  sampleCollectedById String?   @db.Uuid

  /// Narrative reporting, used by imaging and available to pathology.
  findings   String?
  impression String?
  comments   String?

  reportedAt   DateTime?
  reportedById String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  values DiagnosticValue[]

  @@index([tenantId, patientId, createdAt])
  @@index([tenantId, department])
  @@index([tenantId, caseId])
}

/// One measured value. Name, unit and reference range are SNAPSHOTTED so that
/// editing the catalogue later never rewrites a report that has been handed to
/// a patient.
model DiagnosticValue {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  reportId String           @db.Uuid
  report   DiagnosticReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  parameterId String?           @db.Uuid
  parameter   LabTestParameter? @relation(fields: [parameterId], references: [id])

  name        String
  unit        String?
  valueText   String?
  valueNumber Float?
  flag        VitalFlag?
  refLow      Float?
  refHigh     Float?
  refText     String?
  sortOrder   Int        @default(0)

  createdAt DateTime @default(now())

  @@index([tenantId, reportId])
}

// ---------------------------------------------------------------------------
// Pharmacy — medicine master, stock by batch, purchases and dispensing
// ---------------------------------------------------------------------------

model MedicineCategory {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  medicines Medicine[]

  @@unique([tenantId, name])
}

model Medicine {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name        String
  genericName String?
  categoryId  String?           @db.Uuid
  category    MedicineCategory? @relation(fields: [categoryId], references: [id])
  company     String?
  /// e.g. 500mg, 5mg/5ml
  strength    String?
  /// The unit stock is counted in: tablet, capsule, bottle, vial.
  unit        String?

  /// Warn when total stock falls to or below this.
  reorderLevel Int?

  /// Substances this contains, for checking against a patient's recorded
  /// allergies at prescribing time. Free keywords rather than a coded
  /// terminology — honest about what it is, and still catches "penicillin"
  /// written in a doctor's own words.
  allergenKeywords String[] @default([])

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batches           MedicineBatch[]
  purchaseItems     MedicinePurchaseItem[]
  dispenseItems     DispenseItem[]
  prescriptionItems PrescriptionItem[]

  @@unique([tenantId, name, strength])
  @@index([tenantId, genericName])
  @@index([tenantId, categoryId])
}

/// Stock is held per batch because expiry is per batch. Quantity on hand lives
/// here and nowhere else, so there is one number to be right.
model MedicineBatch {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  medicineId String   @db.Uuid
  medicine   Medicine @relation(fields: [medicineId], references: [id])

  batchNo    String
  expiryDate DateTime @db.Date

  /// Units currently on hand in this batch.
  quantity Int @default(0)

  purchasePriceMinor Int?
  salePriceMinor     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dispenseItems DispenseItem[]

  @@unique([tenantId, medicineId, batchNo])
  @@index([tenantId, expiryDate])
  @@index([tenantId, medicineId])
}

model MedicinePurchase {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  supplierName String
  invoiceNo    String?
  purchasedAt  DateTime @default(now())
  note         String?

  totalMinor  Int      @default(0)
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items MedicinePurchaseItem[]

  @@index([tenantId, purchasedAt])
}

model MedicinePurchaseItem {
  id         String           @id @default(uuid()) @db.Uuid
  tenantId   String           @db.Uuid
  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  purchaseId String           @db.Uuid
  purchase   MedicinePurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  medicineId String           @db.Uuid
  medicine   Medicine         @relation(fields: [medicineId], references: [id])

  batchNo            String
  expiryDate         DateTime @db.Date
  quantity           Int
  purchasePriceMinor Int
  salePriceMinor     Int?
  lineTotalMinor     Int

  createdAt DateTime @default(now())

  @@index([tenantId, purchaseId])
}

/// One handover of medicine to a patient. Bills onto the same Case as
/// everything else, so a stay produces one bill and not several.
model Dispense {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  caseId    String  @db.Uuid
  case      Case    @relation(fields: [caseId], references: [id])
  patientId String  @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id])

  opdVisitId  String?    @db.Uuid
  opdVisit    OpdVisit?  @relation(fields: [opdVisitId], references: [id])
  admissionId String?    @db.Uuid
  admission   Admission? @relation(fields: [admissionId], references: [id])

  /// The charge this created. One dispense, one line on the bill.
  billItemId String?   @unique @db.Uuid
  billItem   BillItem? @relation(fields: [billItemId], references: [id])

  dispensedAt   DateTime @default(now())
  dispensedById String?  @db.Uuid
  note          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items DispenseItem[]

  @@index([tenantId, patientId, dispensedAt])
  @@index([tenantId, caseId])
}

model DispenseItem {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  dispenseId String   @db.Uuid
  dispense   Dispense @relation(fields: [dispenseId], references: [id], onDelete: Cascade)

  medicineId String        @db.Uuid
  medicine   Medicine      @relation(fields: [medicineId], references: [id])
  batchId    String        @db.Uuid
  batch      MedicineBatch @relation(fields: [batchId], references: [id])

  /// Snapshotted so renaming a medicine never rewrites a past handover.
  medicineName   String
  batchNo        String
  quantity       Int
  unitPriceMinor Int
  lineTotalMinor Int

  createdAt DateTime @default(now())

  @@index([tenantId, dispenseId])
}

/// A patient's allergies, recorded properly rather than as one free-text blob,
/// so prescribing can actually check against them. The blob on Patient stays
/// as the doctor's own words; this is what the software reasons over.
model PatientAllergy {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @db.Uuid
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  patientId String  @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  substance String
  reaction  String?
  severity  AllergySeverity @default(moderate)

  recordedAt   DateTime @default(now())
  recordedById String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, patientId, substance])
  @@index([tenantId, patientId])
}

// ---------------------------------------------------------------------------
// Finance — money in and out that is not a patient bill
// ---------------------------------------------------------------------------

model IncomeHead {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  incomes Income[]

  @@unique([tenantId, name])
}

model Income {
  id       String     @id @default(uuid()) @db.Uuid
  tenantId String     @db.Uuid
  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  headId   String     @db.Uuid
  head     IncomeHead @relation(fields: [headId], references: [id])

  description String
  amountMinor Int
  receivedAt  DateTime @default(now())
  invoiceNo   String?
  note        String?

  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, receivedAt])
  @@index([tenantId, headId])
}

model ExpenseHead {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]

  @@unique([tenantId, name])
}

model Expense {
  id       String      @id @default(uuid()) @db.Uuid
  tenantId String      @db.Uuid
  tenant   Tenant      @relation(fields: [tenantId], references: [id])
  headId   String      @db.Uuid
  head     ExpenseHead @relation(fields: [headId], references: [id])

  description String
  amountMinor Int
  paidAt      DateTime @default(now())
  invoiceNo   String?
  note        String?

  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, paidAt])
  @@index([tenantId, headId])
}

/// Someone who sends patients to the hospital and is paid a commission for it.
model Referrer {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name          String
  phone         String?
  category      String?
  /// Commission as basis points of the case's net billing. A suggestion — what
  /// is actually paid is entered on the payment.
  commissionBps Int?
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cases    Case[]
  payments ReferralPayment[]

  @@unique([tenantId, name])
}

model ReferralPayment {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  referrerId String   @db.Uuid
  referrer   Referrer @relation(fields: [referrerId], references: [id])

  amountMinor Int
  paidAt      DateTime  @default(now())
  periodFrom  DateTime? @db.Date
  periodTo    DateTime? @db.Date
  note        String?

  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  @@index([tenantId, referrerId, paidAt])
}

// ---------------------------------------------------------------------------
// Inventory — general supplies, distinct from pharmacy stock
//
// Quantity on hand is DERIVED by summing StockMove rows. There is no stored
// balance, so a movement and the balance it produced can never disagree.
// ---------------------------------------------------------------------------

model ItemCategory {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items InventoryItem[]

  @@unique([tenantId, name])
}

model Store {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  moves StockMove[]

  @@unique([tenantId, name])
}

model InventoryItem {
  id         String        @id @default(uuid()) @db.Uuid
  tenantId   String        @db.Uuid
  tenant     Tenant        @relation(fields: [tenantId], references: [id])
  categoryId String?       @db.Uuid
  category   ItemCategory? @relation(fields: [categoryId], references: [id])

  name         String
  unit         String?
  reorderLevel Int?
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  moves StockMove[]

  @@unique([tenantId, name])
  @@index([tenantId, categoryId])
}

model StockMove {
  id       String        @id @default(uuid()) @db.Uuid
  tenantId String        @db.Uuid
  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  itemId   String        @db.Uuid
  item     InventoryItem @relation(fields: [itemId], references: [id])
  storeId  String        @db.Uuid
  store    Store         @relation(fields: [storeId], references: [id])

  kind     StockMoveKind
  /// Always positive. `kind` says which way it moved; an adjustment may be
  /// negative to write stock off.
  quantity Int

  supplierName   String?
  unitCostMinor  Int?
  /// Who the stock was issued to, when it left the store.
  issuedToUserId String? @db.Uuid
  issuedToName   String?

  note        String?
  movedAt     DateTime @default(now())
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  @@index([tenantId, itemId, storeId])
  @@index([tenantId, movedAt])
}

// ---------------------------------------------------------------------------
// Human resources
//
// The login (User) stays lean and is about access. Employment facts — joining
// date, salary, department — live here, so an HR change never touches auth.
// ---------------------------------------------------------------------------

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff StaffProfile[]

  @@unique([tenantId, name])
}

model Designation {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff StaffProfile[]

  @@unique([tenantId, name])
}

model StaffProfile {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  /// One profile per login. Employment data hangs off the identity, not inside it.
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  staffNo String

  departmentId  String?      @db.Uuid
  department    Department?  @relation(fields: [departmentId], references: [id])
  designationId String?      @db.Uuid
  designation   Designation? @relation(fields: [designationId], references: [id])

  phone           String?
  emergencyPhone  String?
  address         String?
  /// CNIC, hashed exactly as a patient's is. Never stored in plain text.
  nationalIdHash  String?
  nationalIdLast4 String?

  joinedOn DateTime  @db.Date
  leftOn   DateTime? @db.Date

  /// Monthly basic pay, in minor units. A default for payroll, always editable
  /// on the payslip itself.
  basicSalaryMinor Int?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendance    StaffAttendance[]
  leaveRequests LeaveRequest[]
  rosterEntries RosterEntry[]
  payslips      Payslip[]

  @@unique([tenantId, staffNo])
  @@index([tenantId, departmentId])
  @@index([tenantId, isActive])
}

model StaffAttendance {
  id       String       @id @default(uuid()) @db.Uuid
  tenantId String       @db.Uuid
  tenant   Tenant       @relation(fields: [tenantId], references: [id])
  staffId  String       @db.Uuid
  staff    StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  /// One row per person per day. The unique constraint is the point.
  onDate   DateTime         @db.Date
  status   AttendanceStatus
  checkIn  DateTime?
  checkOut DateTime?
  note     String?

  markedById String?  @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, staffId, onDate])
  @@index([tenantId, onDate])
}

model LeaveType {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  /// Entitlement per year. Null means uncapped, e.g. unpaid leave.
  daysPerYear Int?
  isPaid      Boolean  @default(true)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requests LeaveRequest[]

  @@unique([tenantId, name])
}

model LeaveRequest {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @db.Uuid
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  staffId     String       @db.Uuid
  staff       StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  leaveTypeId String       @db.Uuid
  leaveType   LeaveType    @relation(fields: [leaveTypeId], references: [id])

  fromDate DateTime @db.Date
  toDate   DateTime @db.Date
  /// Whole days requested, stored because half-days and holidays make it more
  /// than a date subtraction.
  days     Int
  reason   String?

  status       LeaveRequestStatus @default(pending)
  decidedById  String?            @db.Uuid
  decidedAt    DateTime?
  decisionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, staffId, fromDate])
  @@index([tenantId, status])
}

model Shift {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  /// Wall-clock times as HH:mm. A night shift may end before it starts.
  startTime String
  endTime   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rosterEntries RosterEntry[]

  @@unique([tenantId, name])
}

model RosterEntry {
  id       String       @id @default(uuid()) @db.Uuid
  tenantId String       @db.Uuid
  tenant   Tenant       @relation(fields: [tenantId], references: [id])
  staffId  String       @db.Uuid
  staff    StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  shiftId  String       @db.Uuid
  shift    Shift        @relation(fields: [shiftId], references: [id])

  onDate DateTime @db.Date
  wardId String?  @db.Uuid
  ward   Ward?    @relation(fields: [wardId], references: [id])
  note   String?

  assignedById String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, staffId, onDate, shiftId])
  @@index([tenantId, onDate])
}

model PayrollRun {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  /// The month this pays for.
  year  Int
  month Int

  status PayrollRunStatus @default(draft)

  finalisedAt   DateTime?
  finalisedById String?   @db.Uuid
  paidAt        DateTime?
  note          String?

  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payslips Payslip[]

  @@unique([tenantId, year, month])
  @@index([tenantId, status])
}

/// A payslip is a document someone keeps. Its figures are SNAPSHOTS — changing
/// a salary later must never alter what a person was already told they earned.
model Payslip {
  id       String       @id @default(uuid()) @db.Uuid
  tenantId String       @db.Uuid
  tenant   Tenant       @relation(fields: [tenantId], references: [id])
  runId    String       @db.Uuid
  run      PayrollRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  staffId  String       @db.Uuid
  staff    StaffProfile @relation(fields: [staffId], references: [id])

  staffNameSnapshot   String
  staffNoSnapshot     String
  designationSnapshot String?

  basicMinor      Int
  earningsMinor   Int @default(0)
  deductionsMinor Int @default(0)
  netMinor        Int

  /// Attendance that fed the figures, kept so a payslip can be explained later.
  workedDays Int?
  absentDays Int?
  leaveDays  Int?

  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines PayslipLine[]

  @@unique([runId, staffId])
  @@index([tenantId, staffId])
}

model PayslipLine {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @db.Uuid
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  payslipId String  @db.Uuid
  payslip   Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  kind        PayslipLineKind
  name        String
  amountMinor Int
  sortOrder   Int             @default(0)

  createdAt DateTime @default(now())

  @@index([tenantId, payslipId])
}

// ---------------------------------------------------------------------------
// Vitals
// ---------------------------------------------------------------------------

model VitalType {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @db.Uuid
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  name     String
  unit     String
  /// Reference range for abnormal flagging. Null means "don't flag".
  refLow   Float?
  refHigh  Float?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  readings VitalReading[]

  @@unique([tenantId, name])
}

model VitalReading {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @db.Uuid
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  patientId   String     @db.Uuid
  patient     Patient    @relation(fields: [patientId], references: [id])
  caseId      String?    @db.Uuid
  case        Case?      @relation(fields: [caseId], references: [id])
  opdVisitId  String?    @db.Uuid
  opdVisit    OpdVisit?  @relation(fields: [opdVisitId], references: [id])
  admissionId String?    @db.Uuid
  admission   Admission? @relation(fields: [admissionId], references: [id])
  vitalTypeId String     @db.Uuid
  vitalType   VitalType  @relation(fields: [vitalTypeId], references: [id])

  value        Float
  flag         VitalFlag?
  recordedAt   DateTime   @default(now())
  recordedById String?    @db.Uuid

  @@index([tenantId, patientId, recordedAt])
  @@index([tenantId, opdVisitId])
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

/// One billed line against a case. Snapshots the charge's name and list price so
/// later edits to the charge master never rewrite history.
/// One line on a patient's bill: what they took, and what they were charged for
/// it. `serviceName` is snapshotted so renaming a service never rewrites history,
/// and `serviceId` is nullable so a one-off item can be billed without polluting
/// the service list.
model BillItem {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  caseId     String    @db.Uuid
  case       Case      @relation(fields: [caseId], references: [id])
  opdVisitId String?   @db.Uuid
  opdVisit   OpdVisit? @relation(fields: [opdVisitId], references: [id])
  serviceId  String?   @db.Uuid
  service    Service?  @relation(fields: [serviceId], references: [id])

  serviceName       String
  department        ServiceDepartment?
  quantity          Int                @default(1)
  /// What the service list suggested, if anything. Informational only.
  defaultPriceMinor Int?
  /// What this patient was actually charged, per unit.
  priceMinor        Int
  discountBps       Int                @default(0)
  discountMinor     Int                @default(0)
  /// (price * qty) - discount
  netMinor          Int
  /// Why the price was conceded, e.g. a doctor waiving part of his own fee.
  discountReason    String?

  status    BillItemStatus @default(pending)
  paymentId String?        @db.Uuid
  payment   Payment?       @relation(fields: [paymentId], references: [id])

  /// Released to the department without cash — a panel patient or a waiver.
  /// Always carries who approved it and why, so it cannot become a quiet leak.
  approvedWithoutPayment Boolean   @default(false)
  approvalReason         String?
  approvedById           String?   @db.Uuid
  approvedAt             DateTime?

  note        String?
  chargedAt   DateTime @default(now())
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  serviceOrder  ServiceOrder?
  dispense      Dispense?
  bloodIssue    BloodIssue?
  ambulanceCall AmbulanceCall?

  @@index([tenantId, caseId])
  @@index([tenantId, opdVisitId])
  @@index([tenantId, chargedAt])
  @@index([tenantId, department])
  @@index([tenantId, status])
}

model Payment {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  caseId   String @db.Uuid
  case     Case   @relation(fields: [caseId], references: [id])

  receiptNo   String
  amountMinor Int
  mode        PaymentMode @default(cash)
  paidAt      DateTime    @default(now())
  note        String?
  chequeNo    String?
  chequeDate  DateTime?   @db.Date
  documentUrl String?

  /// Set when a payment is reversed; reversals are additive, never deletions.
  reversedAt     DateTime?
  reversalReason String?

  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// The lines this receipt settled.
  billItems BillItem[]

  @@unique([tenantId, receiptNo])
  @@index([tenantId, caseId])
  @@index([tenantId, paidAt])
}

// ---------------------------------------------------------------------------
// Audit — append-only. A migration REVOKEs UPDATE/DELETE for the app DB role.
// ---------------------------------------------------------------------------

model AuditEvent {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String?      @db.Uuid
  actorId    String?      @db.Uuid
  action     String
  entityType String
  entityId   String?
  method     String
  path       String
  ip         String?
  userAgent  String?
  outcome    AuditOutcome
  metadata   Json?
  createdAt  DateTime     @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, action])
}

/// A saved analytics query. The `query` is validated against the dataset
/// registry every time it runs, never trusted because it was stored — a view
/// saved before a field was retired must fail loudly, not silently query
/// something else.
model SavedView {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name        String
  description String?
  /// Dataset id, denormalised so the list can be filtered without parsing JSON.
  dataset     String
  query       Json

  /// Shared views are visible to anyone who can read the dataset.
  isShared Boolean @default(false)

  createdById String?  @db.Uuid
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, createdById, name])
  @@index([tenantId, dataset])
  @@index([tenantId, isShared])
}

// ---------------------------------------------------------------------------
// Blood bank
// ---------------------------------------------------------------------------

model Donor {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  donorNo    String
  firstName  String
  lastName   String
  bloodGroup BloodGroup
  phone      String
  birthDate  DateTime?  @db.Date
  address    String?
  note       String?
  isActive   Boolean    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  units BloodUnit[]

  @@unique([tenantId, donorNo])
  @@index([tenantId, bloodGroup])
  @@index([tenantId, phone])
}

/// One physical bag. Stock on hand is DERIVED by counting units that have not
/// been issued, discarded, or passed their expiry — there is no stored count to
/// drift away from the shelf.
model BloodUnit {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  bagNo      String
  bloodGroup BloodGroup
  component  BloodComponent

  /// Null for a bag bought in rather than collected here.
  donorId String? @db.Uuid
  donor   Donor?  @relation(fields: [donorId], references: [id])

  collectedOn DateTime @db.Date
  /// Always set explicitly. The safe shelf life depends on the anticoagulant
  /// and on whether the component was frozen; no default should decide it.
  expiresOn   DateTime @db.Date
  volumeMl    Int?

  screenedAt      DateTime?
  /// A unit that failed screening can never be issued.
  screeningPassed Boolean?

  issuedAt      DateTime?
  discardedAt   DateTime?
  discardReason String?
  note          String?

  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  issue BloodIssue?

  @@unique([tenantId, bagNo])
  @@index([tenantId, bloodGroup, component])
  @@index([tenantId, expiresOn])
}

/// Issuing a bag. The recipient's group is recorded as the BANK established it
/// by cross-match, not copied from the patient record — the bench test is what
/// the ABO compatibility check must be made against.
model BloodIssue {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  unitId String    @unique @db.Uuid
  unit   BloodUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  patientId String  @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id])
  caseId    String  @db.Uuid
  case      Case    @relation(fields: [caseId], references: [id])

  recipientGroup BloodGroup
  crossMatchedBy String?

  billItemId String?   @unique @db.Uuid
  billItem   BillItem? @relation(fields: [billItemId], references: [id])

  issuedById String?  @db.Uuid
  issuedAt   DateTime @default(now())
  note       String?

  @@index([tenantId, patientId])
  @@index([tenantId, issuedAt])
}

// ---------------------------------------------------------------------------
// Ambulance
// ---------------------------------------------------------------------------

model Vehicle {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  registrationNo String
  model          String?
  type           VehicleType
  driverName     String?
  driverPhone    String?

  /// Suggested rates. What is billed is confirmed on the call.
  baseChargeMinor  Int?
  perKmChargeMinor Int?

  note     String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  calls AmbulanceCall[]

  @@unique([tenantId, registrationNo])
  @@index([tenantId, type])
}

/// A call. The patient is nullable on purpose: an ambulance is often sent to a
/// name and a phone number, and demanding a patient record first would mean
/// either a delayed dispatch or a fictional patient.
model AmbulanceCall {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  callNo    String
  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  patientId String?  @db.Uuid
  patient   Patient? @relation(fields: [patientId], references: [id])
  caseId    String?  @db.Uuid
  case      Case?    @relation(fields: [caseId], references: [id])

  callerName  String?
  callerPhone String?

  emergencyLevel EmergencyLevel
  pickupAddress  String
  dropAddress    String?

  /// The stage is derived from these, never stored alongside them.
  dispatchedAt DateTime  @default(now())
  arrivedAt    DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  distanceKm  Float?
  chargeMinor Int?

  billItemId String?   @unique @db.Uuid
  billItem   BillItem? @relation(fields: [billItemId], references: [id])

  note        String?
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, callNo])
  @@index([tenantId, dispatchedAt])
  @@index([tenantId, vehicleId])
}

// ---------------------------------------------------------------------------
// Statutory registers
// ---------------------------------------------------------------------------

/// The hospital's source document for a birth. The state registration happens
/// at the Union Council and is recorded back here when the family reports it,
/// which can be months later.
model BirthRecord {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  certificateNo String

  /// Often blank at the time of the birth. The register must not force an
  /// invented name onto a legal document.
  childName        String?
  gender           Gender
  bornAt           DateTime
  birthWeightGrams Int?
  deliveryType     DeliveryType

  motherPatientId String?  @db.Uuid
  motherPatient   Patient? @relation("BirthMother", fields: [motherPatientId], references: [id])
  /// Used when the mother is not registered here.
  motherName      String?
  motherCnicHash  String?
  motherCnicLast4 String?
  fatherName      String?
  fatherCnicHash  String?
  fatherCnicLast4 String?
  contactPhone    String?
  address         String?

  attendedById String?       @db.Uuid
  attendedBy   Practitioner? @relation(fields: [attendedById], references: [id])
  /// Set if the newborn is registered as a patient in their own right.
  childPatientId String?  @db.Uuid
  childPatient   Patient? @relation("BirthChild", fields: [childPatientId], references: [id])

  note String?

  /// Union Council / NADRA registration, once the family reports it back.
  registrationNo String?
  registeredOn   DateTime? @db.Date

  recordedById String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, certificateNo])
  @@index([tenantId, bornAt])
  @@index([tenantId, registrationNo])
}

/// A death record closes a patient's file. Recording one also sets
/// `Patient.status = deceased`, so there is one answer to whether someone is
/// alive rather than two that can disagree.
model DeathRecord {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  certificateNo String

  patientId String  @unique @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id])

  diedAt       DateTime
  causeOfDeath String
  placeOfDeath String?

  certifiedById String?       @db.Uuid
  certifiedBy   Practitioner? @relation(fields: [certifiedById], references: [id])

  informantName     String?
  informantPhone    String?
  informantRelation String?
  note              String?

  registrationNo String?
  registeredOn   DateTime? @db.Date

  recordedById String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, certificateNo])
  @@index([tenantId, diedAt])
}

// ---------------------------------------------------------------------------
// Front office
// ---------------------------------------------------------------------------

/// The visitor book. Being inside is derived from `leftAt` being null, which is
/// what makes this usable as an evacuation list.
model VisitorLog {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  passNo String
  name   String
  phone  String?

  patientId String?  @db.Uuid
  patient   Patient? @relation(fields: [patientId], references: [id])
  /// Free text when they are visiting a department rather than a person.
  visitingWhom String?

  purpose          String?
  idCardLast4      String?
  numberOfVisitors Int       @default(1)
  arrivedAt        DateTime  @default(now())
  leftAt           DateTime?
  note             String?

  recordedById String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, passNo])
  @@index([tenantId, arrivedAt])
  @@index([tenantId, leftAt])
}

model PhoneCallLog {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  direction  CallDirection
  callerName String
  phone      String?

  patientId String?  @db.Uuid
  patient   Patient? @relation(fields: [patientId], references: [id])

  purpose         String?
  calledAt        DateTime  @default(now())
  durationMinutes Int?
  outcome         String?
  followUpOn      DateTime? @db.Date
  note            String?

  recordedById String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId, calledAt])
  @@index([tenantId, followUpOn])
}

model PostalLog {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  direction   PostalDirection
  party       String
  addressedTo String?
  reference   String?
  courier     String?
  trackingNo  String?
  onDate      DateTime        @db.Date
  note        String?

  recordedById String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId, onDate])
  @@index([tenantId, direction])
}

model Complaint {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  reference       String
  complainantName String
  phone           String?

  patientId String?  @db.Uuid
  patient   Patient? @relation(fields: [patientId], references: [id])

  about       String?
  severity    ComplaintSeverity
  description String
  status      ComplaintStatus   @default(open)

  assignedToId String? @db.Uuid
  assignedTo   User?   @relation("ComplaintAssignee", fields: [assignedToId], references: [id])
  /// Required before a complaint can be resolved or closed.
  resolution   String?

  receivedAt DateTime  @default(now())
  resolvedAt DateTime?

  recordedById String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, reference])
  @@index([tenantId, status])
  @@index([tenantId, receivedAt])
}

// ---------------------------------------------------------------------------
// Integration: API keys and outbound webhooks
// ---------------------------------------------------------------------------

/// A machine credential. The secret is never stored — only a SHA-256 hash of
/// it, so a leaked database does not hand over working keys. SHA-256 rather
/// than bcrypt on purpose: the secret is 256 bits of randomness, so there is
/// nothing to brute-force, and bcrypt would add its deliberate slowness to
/// every single API request.
model ApiKey {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name        String
  description String?

  /// The visible half, e.g. `hms_a1b2c3d4`. A lookup handle, not a secret.
  prefix  String @unique
  keyHash String

  /// Exactly what this key may do. Explicit, never inherited from a role —
  /// a key must not gain powers because somebody widened a role later.
  scopes String[]

  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?

  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, revokedAt])
}

/// Where to send events. The secret signs deliveries so the receiver can prove
/// the call came from us and not from anyone who learned the URL.
model WebhookEndpoint {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  url         String
  description String?
  secret      String
  /// Which events this endpoint has asked for.
  events      String[]
  isActive    Boolean  @default(true)

  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@index([tenantId, isActive])
}

/// One attempt to deliver one event to one endpoint.
///
/// Deliveries are written inside the transaction that caused them and sent
/// afterwards, so a webhook that is down can never fail the clinical action
/// that triggered it. Retries back off exponentially and then give up: an
/// unbounded queue of undeliverable events is how a webhook system quietly
/// becomes a disk-space incident.
model WebhookDelivery {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  webhookId String          @db.Uuid
  webhook   WebhookEndpoint @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  event   String
  payload Json

  status   DeliveryStatus @default(pending)
  attempts Int            @default(0)

  responseStatus Int?
  error          String?

  lastAttemptAt DateTime?
  nextAttemptAt DateTime? @default(now())
  deliveredAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The dispatcher's working index: what is due, oldest first.
  @@index([status, nextAttemptAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, webhookId, status])
}

// ---------------------------------------------------------------------------
// Patient portal
// ---------------------------------------------------------------------------

/// A patient's own login.
///
/// Deliberately NOT a `User`. A patient given a staff role would be one
/// mistaken grant away from reading somebody else's chart, and every future
/// permission would have to be audited against "but what if a patient holds
/// this". Separate table, separate token type, no permissions at all — the
/// only authority a portal session carries is "you are this patient".
model PatientAccount {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  patientId String  @unique @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  email String?
  phone String?

  /// Null until they set one from their invitation.
  passwordHash String?

  /// Hash of the one-time invitation code. The code itself is shown once, to
  /// the person at the desk, and never stored.
  inviteTokenHash String?
  inviteExpiresAt DateTime?

  isActive    Boolean   @default(true)
  lastLoginAt DateTime?

  /// Wrong-password counter, so a portal login cannot be brute-forced.
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?

  invitedById String?  @db.Uuid
  invitedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, isActive])
}

/// A patient asking for an appointment. The desk turns it into a real
/// Appointment; the portal never writes into the diary itself, or anyone could
/// fill a clinic overnight.
model AppointmentRequest {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  patientId String  @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  practitionerId String?       @db.Uuid
  practitioner   Practitioner? @relation(fields: [practitionerId], references: [id])

  preferredDate DateTime @db.Date
  reason        String?

  status      AppointmentRequestStatus @default(pending)
  handledById String?                  @db.Uuid
  handledAt   DateTime?
  /// The appointment the desk created from this, once it did.
  appointmentId String?      @unique @db.Uuid
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  declineReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status, preferredDate])
  @@index([tenantId, patientId])
}
