# Copy to apps/api/.env

NODE_ENV=development
PORT=3000

# CORS — the web app origin(s), comma separated
WEB_ORIGIN=http://localhost:5173

# Postgres.
#  - Local docker-compose:  postgresql://hms:hms_dev_password@localhost:5432/hms?schema=public
#  - Neon / serverless: use the direct (unpooled) endpoint, drop channel_binding
#    (Prisma doesn't support it), and add &connect_timeout=15 to ride out compute cold starts:
#    postgresql://USER:PASS@ep-xxxx.REGION.aws.neon.tech/DB?sslmode=require&connect_timeout=15
#
#    Also set connection_limit and pool_timeout explicitly. Prisma's default
#    limit is (cores * 2 + 1) — 9 on a 4-core machine — and Row-Level Security
#    means every tenant-scoped query runs inside its own transaction, so each
#    in-flight query holds one of those connections for a full round trip. Nine
#    is low for that, and when a suspended compute takes a second or two to wake,
#    queries queue behind the wake and the pool times out at its 10s default:
#      "Timed out fetching a new connection from the connection pool"
#    &connection_limit=20&pool_timeout=20
DATABASE_URL=postgresql://hms:hms_dev_password@localhost:5432/hms?schema=public

# Redis (used from Phase 2 for queues/cache)
REDIS_URL=redis://localhost:6379

# Auth — generate strong random values for anything non-local:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-change-me-access
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev-only-change-me-refresh
JWT_REFRESH_TTL=30d

# Salt for hashing national IDs (CNIC). Change per environment; never commit the real one.
NATIONAL_ID_HASH_SALT=dev-only-change-me-salt

# Rate limiting (per IP)
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
